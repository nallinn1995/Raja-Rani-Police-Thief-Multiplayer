# Generate AUTH_TOKEN_SECRET with a password manager or cryptographically secure generator.
AUTH_TOKEN_SECRET=replace-with-a-random-32-character-minimum-secret
# Use a strong administrator password, preferably a scrypt hash generated by the application.
ADMIN_PASSWORD=replace-with-a-strong-admin-password-or-scrypt-hash
# MONGODB_URI=mongodb://localhost:27017/raja-rani
MONGODB_URI=mongodb+srv://nalli:Mydb%401995%26@rajarani.begckll.mongodb.net/?appName=rajarani
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
VITE_SERVER_URL=http://localhost:3001

# Google OAuth 2.0 / Google Identity Services
# Obtain your Client ID and Client Secret from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase Cloud Messaging - Frontend (Vite)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
# VAPID Key: Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates -> Key pair
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key

# Firebase Cloud Messaging - Backend (Firebase Admin SDK)
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Use the complete private key with escaped newlines (\n) or standard PEM
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
